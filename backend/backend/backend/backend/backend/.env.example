# --- AI Provider Keys ---
FIREWORKS_API_KEY=your_fireworks_api_key_here
JARVIS_DEFAULT_PROVIDER=fireworks
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2-instruct-0905

# Optional fallback provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Security & Login ---
# Generate a long random secret string (at least 32 characters) and NEVER change it after users register
JARVIS_AUTH_SECRET=change_this_to_a_long_random_secret_string
JARVIS_ALLOW_REGISTRATION=true
JARVIS_TOKEN_TTL_MINUTES=1440

# --- Database & Logs ---
JARVIS_DB_PATH=/app/data/jarvis.db
JARVIS_LOG_LEVEL=INFO
JARVIS_ALLOWED_ORIGINS=*